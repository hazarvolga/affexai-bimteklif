#6= IFCORGANIZATION($,'Org',$,$,$);

/* Bir adet standart duvar ve C25 Beton Pozu (15.120.1001) */
#10= IFCWALLSTANDARDCASE('1111111111111111111111',#2,'Test Duvari',$,$,$,$,$);
#20= IFCPROPERTYSINGLEVALUE('PozNo',$,IFCTEXT('15.120.1001'),$);
#21= IFCPROPERTYSET('2222222222222222222222',#2,'Tr_Pset_CSB',$,(#20));
#22= IFCRELDEFINESBYPROPERTIES('3333333333333333333333',#2,$,$,(#10),#21);

/* Bir adet C25/30 Hazır Beton Plak/Doseme */
#11= IFCSLAB('4444444444444444444444',#2,'Test Doseme',$,$,$,$,$);
#23= IFCPROPERTYSINGLEVALUE('PozNo',$,IFCTEXT('15.120.1001'),$);
#24= IFCPROPERTYSET('5555555555555555555555',#2,'Tr_Pset_CSB',$,(#23));
#25= IFCRELDEFINESBYPROPERTIES('6666666666666666666666',#2,$,$,(#11),#24);

/* Arazi (Site) uzerinde TAKS ve KAKS parametreleri */
#30= IFCSITE('7777777777777777777777',#2,'Test Arazi',$,$,$,$,$,$,$,$,$,$,$);
#31= IFCPROPERTYSINGLEVALUE('TAKS',$,IFCREAL(0.40),$);
#32= IFCPROPERTYSINGLEVALUE('KAKS',$,IFCREAL(1.20),$);
