// F15 shadow model only. Do not run migrate/db push from the pilot app.
// The Express + Drizzle application remains the single write owner until the
// external pilot admission and parity gates are satisfied.

generator client {
  provider = "prisma-client-js"
  output   = "../../.prisma/shadow-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  TRY
  USD
  EUR

  @@map("currency")
}

enum UserRole {
  owner
  admin
  manager
  viewer

  @@map("user_role")
}

enum PipelineStage {
  lead
  contacted
  quotation_sent
  negotiation
  won
  lost

  @@map("pipeline_stage")
}

enum QuoteStatus {
  draft
  sent
  negotiation
  won
  lost
  archived

  @@map("quote_status")
}

enum DocumentStatus {
  uploaded
  queued
  processing
  awaiting_review
  completed
  failed
  cancelled
  archived

  @@map("document_status")
}

enum ProcessingRunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("processing_run_status")
}

enum ProcessingStage {
  queued
  parsing
  normalizing
  validating
  awaiting_review
  extracting_rules
  consolidating
  preparing_review
  completed
  failed
  cancelled

  @@map("processing_stage")
}

model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  email              String                  @unique @db.Text
  passwordHash       String?                 @map("password_hash") @db.Text
  fullName           String                  @map("full_name") @db.Text
  emailVerified      DateTime?               @map("email_verified") @db.Timestamp(6)
  verificationToken  String?                 @map("verification_token") @db.Text
  passwordChangedAt  DateTime?               @map("password_changed_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  memberships        Membership[]

  @@map("users")
}

model Company {
  id                                  String                  @id @default(uuid()) @db.Uuid
  name                                String                  @db.Text
  logoUrl                             String?                 @map("logo_url") @db.Text
  taxNumber                           String?                 @map("tax_number") @db.Text
  taxOffice                           String?                 @map("tax_office") @db.Text
  address                             String?                 @db.Text
  signatureUrl                        String?                 @map("signature_url") @db.Text
  stampUrl                            String?                 @map("stamp_url") @db.Text
  defaultCurrency                     Currency                @default(TRY) @map("default_currency")
  defaultVatRate                      Int                     @default(20) @map("default_vat_rate")
  smartcheckMaxWaste                  Decimal                 @default(20) @map("smartcheck_max_waste_percent") @db.Decimal(5, 2)
  defaultEscalationVolatility         Decimal                 @default(0) @map("default_escalation_volatility_percent") @db.Decimal(5, 2)
  defaultCarbonRiskPremium             Decimal                 @default(0) @map("default_carbon_risk_premium_percent") @db.Decimal(5, 2)
  defaultInformationDeliveryCost       Decimal                 @default(0) @map("default_information_delivery_cost_percent") @db.Decimal(5, 2)
  phone                               String?                 @db.Text
  email                               String?                 @db.Text
  createdAt                           DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  memberships        Membership[]
  clients            Client[]
  quotations         Quotation[]
  documents          Document[]
  processingRuns     DocumentProcessingRun[]
  normalizedRows     NormalizedQuantityRow[]
  quotationItems     QuotationItem[]
  quotationEvidence QuotationItemEvidence[]
  auditLogs          SmartcheckAuditLog[]
  pilotCases         SmartcheckPilotCase[]
  pilotMeasurements  SmartcheckPilotMeasurement[]

  @@map("companies")
}

model Membership {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  companyId       String                  @map("company_id") @db.Uuid
  role            UserRole                @default(viewer)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  user            User                    @relation(fields: [userId], references: [id])
  company         Company                 @relation(fields: [companyId], references: [id])
  uploadedDocuments Document[]             @relation("DocumentUploader")
  reviewedRows    NormalizedQuantityRow[]  @relation("RowReviewer")
  auditLogs       SmartcheckAuditLog[]     @relation("AuditActor")
  createdPilotCases SmartcheckPilotCase[]  @relation("PilotCaseCreator")
  reviewedPilotCases SmartcheckPilotCase[] @relation("PilotCaseReviewer")
  measurements    SmartcheckPilotMeasurement[] @relation("PilotMeasurementActor")
  evidenceCreated QuotationItemEvidence[] @relation("EvidenceCreator")

  @@unique([userId, companyId], name: "memberships_user_id_company_id_key")
  @@map("memberships")
}

model Client {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  name        String      @db.Text
  type        String      @db.Text
  phone       String?     @db.Text
  email       String?     @db.Text
  address     String?     @db.Text
  notes       String?     @db.Text
  pipelineStage PipelineStage @default(lead) @map("pipeline_stage")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  company     Company     @relation(fields: [companyId], references: [id])
  quotations  Quotation[]

  @@unique([id, companyId], name: "clients_id_company_id_key")
  @@map("clients")
}

model Quotation {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @map("company_id") @db.Uuid
  clientId        String                  @map("client_id") @db.Uuid
  quoteNumber     String                  @map("quote_number") @db.Text
  projectName     String                  @map("project_name") @db.Text
  date            DateTime                @default(now()) @db.Timestamp(6)
  expiryDate      DateTime                @map("expiry_date") @db.Timestamp(6)
  currency        Currency                @default(TRY)
  notes           String?                 @db.Text
  status          QuoteStatus              @default(draft)
  industryId      String?                 @map("industry_id") @db.Text
  projectDurationMonths Int                @default(1) @map("project_duration_months")
  escalationVolatilityPercent Decimal     @default(0) @map("escalation_volatility_percent") @db.Decimal(5, 2)
  procurementProfile String                @default("standard") @map("procurement_profile") @db.Text
  carbonRiskPremiumPercent Decimal        @default(0) @map("carbon_risk_premium_percent") @db.Decimal(5, 2)
  informationDeliveryLevel String         @default("none") @map("information_delivery_level") @db.Text
  informationDeliveryCostPercent Decimal  @default(0) @map("information_delivery_cost_percent") @db.Decimal(5, 2)
  observedActualCost Decimal?             @map("observed_actual_cost") @db.Decimal(20, 2)
  observedActualDurationMonths Int?       @map("observed_actual_duration_months")
  calibrationStatus String                @default("not_collected") @map("calibration_status") @db.Text
  calibrationNote String?                 @map("calibration_note") @db.Text
  pricingSnapshotLockStatus String        @default("unlocked") @map("pricing_snapshot_lock_status") @db.Text
  pricingSnapshotLockedAt DateTime?       @map("pricing_snapshot_locked_at") @db.Timestamptz(6)
  pricingSnapshotLockedByUserId String?   @map("pricing_snapshot_locked_by_user_id") @db.Uuid
  pricingSnapshotLockHash String?         @map("pricing_snapshot_lock_hash") @db.Text
  subtotal        Decimal                 @db.Decimal(20, 2)
  discountTotal   Decimal                 @map("discount_total") @db.Decimal(20, 2)
  vatTotal        Decimal                 @map("vat_total") @db.Decimal(20, 2)
  grandTotal      Decimal                 @map("grand_total") @db.Decimal(20, 2)
  revisionVersion Int                     @default(1) @map("revision_version")
  isLatest        Boolean                 @default(true) @map("is_latest")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime                @default(now()) @map("updated_at") @db.Timestamp(6)
  parentId        String?                 @map("parent_id") @db.Uuid
  company         Company                 @relation(fields: [companyId], references: [id])
  client          Client                  @relation(fields: [clientId, companyId], references: [id, companyId])
  items           QuotationItem[]
  evidence        QuotationItemEvidence[]

  @@unique([id, companyId], name: "quotations_id_company_id_key")
  @@map("quotations")
}

model Document {
  id                String                  @id @default(uuid()) @db.Uuid
  companyId         String                  @map("company_id") @db.Uuid
  uploadedByUserId  String                  @map("uploaded_by_user_id") @db.Uuid
  originalFileName  String                  @map("original_file_name") @db.Text
  displayName       String                  @map("display_name") @db.Text
  mimeType          String                  @map("mime_type") @db.Text
  fileSizeBytes     BigInt                  @map("file_size_bytes")
  storageKey        String                  @map("storage_key") @db.Text
  checksumSha256    String                  @map("checksum_sha256") @db.Text
  importMappingJson Json                    @default("{}") @map("import_mapping_json")
  status            DocumentStatus          @default(uploaded)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime?               @map("archived_at") @db.Timestamptz(6)
  company           Company                 @relation(fields: [companyId], references: [id])
  uploader          Membership              @relation("DocumentUploader", fields: [uploadedByUserId, companyId], references: [userId, companyId])
  processingRuns    DocumentProcessingRun[]
  normalizedRows    NormalizedQuantityRow[]
  quotationSources  QuotationItem[]         @relation("QuotationItemSourceDocument")
  evidenceSources   QuotationItemEvidence[] @relation("EvidenceSourceDocument")
  pilotCases        SmartcheckPilotCase[]

  @@unique([id, companyId], name: "documents_id_company_id_key")
  @@map("documents")
}

model DocumentProcessingRun {
  id                String                  @id @default(uuid()) @db.Uuid
  companyId         String                  @map("company_id") @db.Uuid
  documentId        String                  @map("document_id") @db.Uuid
  status            ProcessingRunStatus     @default(queued)
  currentStage      ProcessingStage        @default(queued) @map("current_stage")
  idempotencyKey    String                  @map("idempotency_key") @db.Text
  pipelineVersion   Int                     @default(1) @map("pipeline_version")
  provider          String?                 @db.Text
  model             String?                 @db.Text
  progressPercent   Int                     @default(0) @map("progress_percent")
  progressMessage   String?                 @map("progress_message") @db.Text
  errorCode         String?                 @map("error_code") @db.Text
  errorMessage      String?                 @map("error_message") @db.Text
  startedAt         DateTime?               @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  company           Company                 @relation(fields: [companyId], references: [id])
  document          Document                @relation(fields: [documentId, companyId], references: [id, companyId])
  normalizedRows    NormalizedQuantityRow[]
  quotationSources  QuotationItem[]         @relation("QuotationItemSourceRun")
  evidenceSources   QuotationItemEvidence[] @relation("EvidenceSourceRun")
  pilotMeasurements SmartcheckPilotMeasurement[]

  @@unique([id, companyId], name: "document_processing_runs_id_company_id_key")
  @@unique([id, documentId, companyId], name: "document_processing_runs_id_document_id_company_id_key")
  @@unique([companyId, documentId, idempotencyKey], name: "document_processing_runs_company_document_idempotency_key")
  @@map("document_processing_runs")
}

model NormalizedQuantityRow {
  id                    String                  @id @default(uuid()) @db.Uuid
  companyId             String                  @map("company_id") @db.Uuid
  documentId            String                  @map("document_id") @db.Uuid
  processingRunId       String                  @map("processing_run_id") @db.Uuid
  sheetName             String                  @map("sheet_name") @db.Text
  sourceRowNumber       Int                     @map("source_row_number")
  sourceCellRange       String                  @map("source_cell_range") @db.Text
  rawDescription        String?                 @map("raw_description") @db.Text
  rawPositionCode       String?                 @map("raw_position_code") @db.Text
  rawUnit               String?                 @map("raw_unit") @db.Text
  rawQuantity           String?                 @map("raw_quantity") @db.Text
  rawPrice              String?                 @map("raw_price") @db.Text
  rawWastePercent       String?                 @map("raw_waste_percent") @db.Text
  formulaJson           Json                    @default("{}") @map("formula_json")
  normalizedDescription String?                 @map("normalized_description") @db.Text
  normalizedPositionCode String?                @map("normalized_position_code") @db.Text
  normalizedUnit        String?                 @map("normalized_unit") @db.Text
  normalizedQuantity    Decimal?                @map("normalized_quantity") @db.Decimal(20, 4)
  normalizedPrice       Decimal?                @map("normalized_price") @db.Decimal(20, 2)
  normalizedWaste       Decimal                 @default(0) @map("normalized_waste_percent") @db.Decimal(5, 2)
  mappingConfidence     Decimal                 @default(0) @map("mapping_confidence") @db.Decimal(3, 2)
  reviewStatus          String                  @default("pending_review") @map("review_status") @db.Text
  findingsJson          Json                    @default("[]") @map("findings_json")
  reviewerUserId        String?                 @map("reviewer_user_id") @db.Uuid
  reviewedAt            DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  quantitySource        String                  @default("document") @map("quantity_source") @db.Text
  priceSource           String                  @default("document") @map("price_source") @db.Text
  reviewerNotes         String?                 @map("reviewer_notes") @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  company               Company                 @relation(fields: [companyId], references: [id])
  document              Document                @relation(fields: [documentId, companyId], references: [id, companyId])
  processingRun         DocumentProcessingRun  @relation(fields: [processingRunId, documentId, companyId], references: [id, documentId, companyId])
  reviewer              Membership?            @relation("RowReviewer", fields: [reviewerUserId, companyId], references: [userId, companyId])
  quotationItems        QuotationItem[]
  evidence              QuotationItemEvidence[] @relation("EvidenceSourceRow")

  @@unique([id, companyId], name: "normalized_quantity_rows_id_company_id_key")
  @@unique([companyId, processingRunId, sheetName, sourceRowNumber], name: "normalized_quantity_rows_source_key")
  @@map("normalized_quantity_rows")
}

model QuotationItem {
  id                    String                  @id @default(uuid()) @db.Uuid
  companyId             String                  @map("company_id") @db.Uuid
  quotationId           String                  @map("quotation_id") @db.Uuid
  description           String                  @db.Text
  unit                  String                  @db.Text
  quantity              Decimal                 @db.Decimal(20, 4)
  unitPrice             Decimal                 @map("unit_price") @db.Decimal(20, 2)
  costUnitPrice         Decimal?                @map("cost_unit_price") @db.Decimal(20, 2)
  wastePercent          Decimal                 @default(0) @map("waste_percent") @db.Decimal(5, 2)
  costCategory          String                  @default("material") @map("cost_category") @db.Text
  quantitySource        String                  @default("manual") @map("quantity_source") @db.Text
  priceSource           String                  @default("manual") @map("price_source") @db.Text
  sourceReference       String?                 @map("source_reference") @db.Text
  verificationStatus    String                  @default("unverified") @map("verification_status") @db.Text
  sourceDocumentId      String?                 @map("source_document_id") @db.Uuid
  sourceProcessingRunId String?                 @map("source_processing_run_id") @db.Uuid
  sourceQuantityRowId   String?                 @map("source_quantity_row_id") @db.Uuid
  sourceCellRange       String?                 @map("source_cell_range") @db.Text
  sourceRuleVersion     String?                 @map("source_rule_version") @db.Text
  transferIdempotencyKey String?                @map("transfer_idempotency_key") @db.Text
  priceSnapshotId       String?                 @map("price_snapshot_id") @db.Uuid
  priceSnapshotLockedAt DateTime?               @map("price_snapshot_locked_at") @db.Timestamptz(6)
  priceSnapshotStatus   String                  @default("none") @map("price_snapshot_status") @db.Text
  discountPercent       Decimal                 @default(0) @map("discount_percent") @db.Decimal(5, 2)
  vatPercent            Decimal                 @default(20) @map("vat_percent") @db.Decimal(5, 2)
  total                 Decimal                 @db.Decimal(20, 2)
  company               Company                 @relation(fields: [companyId], references: [id])
  quotation             Quotation               @relation(fields: [quotationId, companyId], references: [id, companyId])
  sourceDocument        Document?               @relation("QuotationItemSourceDocument", fields: [sourceDocumentId, companyId], references: [id, companyId])
  sourceProcessingRun   DocumentProcessingRun?  @relation("QuotationItemSourceRun", fields: [sourceProcessingRunId, sourceDocumentId, companyId], references: [id, documentId, companyId])
  sourceQuantityRow     NormalizedQuantityRow?  @relation(fields: [sourceQuantityRowId, companyId], references: [id, companyId])
  evidence              QuotationItemEvidence[]

  @@unique([id, companyId], name: "quotation_items_id_company_id_key")
  @@unique([id, quotationId, companyId], name: "quotation_items_id_quotation_id_company_id_key")
  @@unique([companyId, quotationId, transferIdempotencyKey], name: "quotation_items_transfer_idempotency_key")
  @@map("quotation_items")
}

model QuotationItemEvidence {
  id                    String                  @id @default(uuid()) @db.Uuid
  companyId             String                  @map("company_id") @db.Uuid
  quotationId           String                  @map("quotation_id") @db.Uuid
  quotationItemId       String                  @map("quotation_item_id") @db.Uuid
  evidenceType          String                  @map("evidence_type") @db.Text
  evidenceKey           String                  @map("evidence_key") @db.Text
  priceSnapshotId       String?                 @map("price_snapshot_id") @db.Uuid
  sourceDocumentId      String?                 @map("source_document_id") @db.Uuid
  sourceProcessingRunId String?                 @map("source_processing_run_id") @db.Uuid
  sourceQuantityRowId   String?                 @map("source_quantity_row_id") @db.Uuid
  sourceCellRange       String?                 @map("source_cell_range") @db.Text
  sourceDocumentHash    String?                 @map("source_document_hash") @db.Text
  capturedValueJson     Json                    @default("{}") @map("captured_value_json")
  status                String                  @default("current") @db.Text
  createdByUserId       String                  @map("created_by_user_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  company               Company                 @relation(fields: [companyId], references: [id])
  quotation             Quotation               @relation(fields: [quotationId, companyId], references: [id, companyId])
  quotationItem         QuotationItem           @relation(fields: [quotationItemId, quotationId, companyId], references: [id, quotationId, companyId])
  sourceDocument        Document?               @relation("EvidenceSourceDocument", fields: [sourceDocumentId, companyId], references: [id, companyId])
  sourceProcessingRun   DocumentProcessingRun?  @relation("EvidenceSourceRun", fields: [sourceProcessingRunId, sourceDocumentId, companyId], references: [id, documentId, companyId])
  sourceQuantityRow     NormalizedQuantityRow?  @relation("EvidenceSourceRow", fields: [sourceQuantityRowId, companyId], references: [id, companyId])
  creator               Membership              @relation("EvidenceCreator", fields: [createdByUserId, companyId], references: [userId, companyId])

  @@unique([id, companyId], name: "quotation_item_evidence_id_company_id_key")
  @@unique([companyId, quotationItemId, evidenceKey], name: "quotation_item_evidence_key_unique")
  @@map("quotation_item_evidence")
}

model SmartcheckAuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  action      String      @db.Text
  entityType  String      @map("entity_type") @db.Text
  entityId    String?     @map("entity_id") @db.Uuid
  metadataJson Json       @default("{}") @map("metadata_json")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  company     Company     @relation(fields: [companyId], references: [id])
  actor       Membership  @relation("AuditActor", fields: [userId, companyId], references: [userId, companyId])

  @@index([companyId, createdAt], name: "idx_smartcheck_audit_lookup")
  @@map("smartcheck_audit_logs")
}

model SmartcheckPilotCase {
  id                 String                    @id @default(uuid()) @db.Uuid
  companyId          String                    @map("company_id") @db.Uuid
  documentId         String                    @map("document_id") @db.Uuid
  pilotId            String                    @map("pilot_id") @db.Text
  customerReference  String                    @map("customer_reference") @db.Text
  projectReference   String                    @map("project_reference") @db.Text
  discipline         String                    @default("MEP") @db.Text
  permissionReference String                   @map("permission_reference") @db.Text
  permissionGrantedAt DateTime                 @map("permission_granted_at") @db.Timestamptz(6)
  retentionUntil     DateTime                   @map("retention_until") @db.Timestamptz(6)
  status             String                    @default("admitted") @db.Text
  expectedRowCount  Int?                       @map("expected_row_count")
  workflowStartedAt DateTime                   @default(now()) @map("workflow_started_at") @db.Timestamptz(6)
  workflowCompletedAt DateTime?               @map("workflow_completed_at") @db.Timestamptz(6)
  reviewerUserId    String?                    @map("reviewer_user_id") @db.Uuid
  reviewerRole      String?                    @map("reviewer_role") @db.Text
  reviewedAt        DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  reviewerDecision  String?                    @map("reviewer_decision") @db.Text
  reviewerNotes     String?                    @map("reviewer_notes") @db.Text
  createdByUserId   String                     @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  company           Company                    @relation(fields: [companyId], references: [id])
  document          Document                   @relation(fields: [documentId, companyId], references: [id, companyId])
  creator           Membership                 @relation("PilotCaseCreator", fields: [createdByUserId, companyId], references: [userId, companyId])
  reviewer          Membership?               @relation("PilotCaseReviewer", fields: [reviewerUserId, companyId], references: [userId, companyId])
  measurements      SmartcheckPilotMeasurement[]

  @@unique([id, companyId], name: "smartcheck_pilot_cases_id_company_id_key")
  @@unique([companyId, pilotId, documentId], name: "smartcheck_pilot_cases_pilot_document_key")
  @@map("smartcheck_pilot_cases")
}

model SmartcheckPilotMeasurement {
  id                  String                  @id @default(uuid()) @db.Uuid
  companyId           String                  @map("company_id") @db.Uuid
  pilotCaseId         String                  @map("pilot_case_id") @db.Uuid
  processingRunId     String?                 @map("processing_run_id") @db.Uuid
  measuredByUserId    String                  @map("measured_by_user_id") @db.Uuid
  measurementKey      String                  @map("measurement_key") @db.Text
  measuredAt          DateTime                @default(now()) @map("measured_at") @db.Timestamptz(6)
  totalRows           Int                     @default(0) @map("total_rows")
  parsedRows          Int                     @default(0) @map("parsed_rows")
  manuallyCorrectedRows Int                   @default(0) @map("manually_corrected_rows")
  findingCount        Int                     @default(0) @map("finding_count")
  approvedRows        Int                     @default(0) @map("approved_rows")
  transferredRows     Int                     @default(0) @map("transferred_rows")
  provenanceCompleteRows Int                  @default(0) @map("provenance_complete_rows")
  processingDurationSeconds Int?              @map("processing_duration_seconds")
  workflowDurationSeconds Int?                @map("workflow_duration_seconds")
  parseRate           Decimal?                @map("parse_rate") @db.Decimal(5, 4)
  manualReentryFreeRate Decimal?              @map("manual_reentry_free_rate") @db.Decimal(5, 4)
  provenanceCoverage  Decimal?                @map("provenance_coverage") @db.Decimal(5, 4)
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  company             Company                 @relation(fields: [companyId], references: [id])
  pilotCase           SmartcheckPilotCase    @relation(fields: [pilotCaseId, companyId], references: [id, companyId])
  processingRun       DocumentProcessingRun?  @relation(fields: [processingRunId, companyId], references: [id, companyId])
  measuredBy          Membership              @relation("PilotMeasurementActor", fields: [measuredByUserId, companyId], references: [userId, companyId])

  @@unique([id, companyId], name: "smartcheck_pilot_measurements_id_company_id_key")
  @@unique([companyId, pilotCaseId, measurementKey], name: "smartcheck_pilot_measurements_case_key")
  @@map("smartcheck_pilot_measurements")
}
