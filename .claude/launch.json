{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "teklifpro-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "teklifpro-review",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.review.local; set +a; exec pnpm run dev"
      ],
      "port": 3001
    }
  ]
}
