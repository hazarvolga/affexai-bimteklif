# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional primary AI provider. If omitted, Gemini fallback is used.
OPENAI_API_KEY=""

# OPENAI_MODEL: Optional OpenAI model override for structured quote generation.
OPENAI_MODEL="gpt-4o-mini"

# JWT_SECRET: Required in production. Use a long random secret.
JWT_SECRET="change-me"

# PUBLIC_APP_URL: Absolute public origin used in email verification and password-reset links.
PUBLIC_APP_URL="http://localhost:3000"

# AUTH_EMAIL_DELIVERY_MODE: smtp, webhook (default), or disabled; configured provider required in production.
# Set disabled explicitly while email provider selection is pending; registration, new invitations,
# verification resend and password-reset email requests return 503 without creating records.
AUTH_EMAIL_DELIVERY_MODE="webhook"

# SMTP mode: authenticated TLS on 465 or required STARTTLS on 587; valid server certificate required.
# Inject these only into the app service. Self-hosted SMTP DNS/PTR/DKIM setup is separate.
AUTH_EMAIL_SMTP_HOST=""
AUTH_EMAIL_SMTP_PORT="465"
AUTH_EMAIL_SMTP_USER=""
AUTH_EMAIL_SMTP_PASSWORD=""
AUTH_EMAIL_FROM=""

# AUTH_EMAIL_WEBHOOK_URL: n8n/provider webhook receiving { template, email, url } for auth emails.
AUTH_EMAIL_WEBHOOK_URL=""

# AUTH_EMAIL_WEBHOOK_SECRET: Required non-placeholder 32+ character bearer secret in production webhook mode.
AUTH_EMAIL_WEBHOOK_SECRET=""

# TRUST_PROXY_HOPS: Coolify reverse-proxy hop count used for correct client IP rate limiting.
TRUST_PROXY_HOPS="1"

# SOURCE_COMMIT: Optional deployed git SHA exposed by /api/health for release verification.
SOURCE_COMMIT=""

# ACADEMY_ADMIN_EMAILS: Comma-separated verified accounts allowed to view global Academy activation metrics.
ACADEMY_ADMIN_EMAILS=""

# ACADEMY_PAYMENT_WEBHOOK_SECRET: Random HMAC secret of at least 32 bytes for verified Academy purchase/refund events.
ACADEMY_PAYMENT_WEBHOOK_SECRET=""

# SmartCheck XLSX/CSV/IFC pilot. Production requires an explicit company allowlist and S3-compatible bucket.
SMARTCHECK_IMPORT_ENABLED="false"
SMARTCHECK_PILOT_COMPANY_IDS=""
SMARTCHECK_LOCAL_STORAGE_DIR=".data/smartcheck"
SMARTCHECK_S3_BUCKET=""
SMARTCHECK_S3_REGION=""
SMARTCHECK_S3_ENDPOINT=""
SMARTCHECK_S3_ACCESS_KEY_ID=""
SMARTCHECK_S3_SECRET_ACCESS_KEY=""
SMARTCHECK_S3_FORCE_PATH_STYLE="false"
SMARTCHECK_S3_SMOKE_PREFIX="smartcheck-smoke"
SMARTCHECK_PROCESSING_STALE_MINUTES="15"

# SmartCheck Worker & Queue Settings
GRAPHILE_WORKER_SCHEMA="teklifpro_queue"
SMARTCHECK_WORKER_CONCURRENCY="2"

# SmartCheck IFC Engine & Worker Settings
SMARTCHECK_IFC_ENGINE="ifcopenshell"
SMARTCHECK_IFC_TIMEOUT_SEC="600"
SMARTCHECK_IFC_WORKER_CONCURRENCY="1"
SMARTCHECK_MAX_IFC_FILE_MB="100"
SMARTCHECK_IFC_MAX_CONCURRENT="2"
SMARTCHECK_IFC_MONTHLY_LIMIT=""
PYTHON_BIN="python3"


# SENTRY_DSN: Optional production error/performance reporting target.
SENTRY_DSN=""

# LOG_LEVEL: Optional server log verbosity.
LOG_LEVEL="info"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database URL (Cloud SQL)
DATABASE_URL="postgres://user:password@localhost:5432/dbname"

# For PDF production (optional settings)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
