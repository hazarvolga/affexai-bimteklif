# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional primary AI provider. If omitted, Gemini fallback is used.
OPENAI_API_KEY=""

# OPENAI_MODEL: Optional OpenAI model override for structured quote generation.
OPENAI_MODEL="gpt-4o-mini"

# JWT_SECRET: Required in production. Use a long random secret.
JWT_SECRET="change-me"

# ACADEMY_PAYMENT_WEBHOOK_SECRET: HMAC secret for verified Academy purchase/refund events.
ACADEMY_PAYMENT_WEBHOOK_SECRET=""

# SENTRY_DSN: Optional production error/performance reporting target.
SENTRY_DSN=""

# LOG_LEVEL: Optional server log verbosity.
LOG_LEVEL="info"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database URL (Cloud SQL)
DATABASE_URL="postgres://user:password@localhost:5432/dbname"

# For PDF production (optional settings)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
