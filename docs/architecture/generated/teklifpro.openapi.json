  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SmartCheckUploadRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mimeType": {
            "type": "string",
            "maxLength": 255
          },
          "fileSizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "fileName",
          "mimeType",
          "fileSizeBytes"
        ],
        "additionalProperties": {}
      },
      "SmartCheckCompleteRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "checksumSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "checksumSha256"
        ],
        "additionalProperties": {}
      },
      "SmartCheckMappingRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "maxLength": 120
          },
          "sheet": {
            "type": "string",
            "maxLength": 120
          },
          "positionCode": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 120
          },
          "unit": {
            "type": "string",
            "maxLength": 120
          },
          "quantity": {
            "type": "string",
            "maxLength": 120
          },
          "price": {
            "type": "string",
            "maxLength": 120
          },
          "wastePercent": {
            "type": "string",
            "maxLength": 120
          },
          "headerRow": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": {}
      },
      "SmartCheckRowReviewRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "accepted_exception"
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewerDiscipline": {
            "type": "string",
            "enum": [
              "STR",
              "ARC",
              "MEP"
            ]
          },
          "correction": {
            "type": "object",
            "properties": {
              "positionCode": {
                "type": "string",
                "maxLength": 500
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "unit": {
                "type": "string",
                "maxLength": 120
              },
              "quantity": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "price": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "wastePercent": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": {}
      },
      "SmartCheckTransferRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "quotationId": {
            "type": "string",
            "minLength": 1
          },
          "rowIds": {
            "minItems": 1,
            "maxItems": 5000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "overrides": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "quantity": {},
                "unitPrice": {},
                "costUnitPrice": {},
                "wastePercent": {},
                "vatPercent": {},
                "priceSnapshotId": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "quotationId",
          "rowIds"
        ],
        "additionalProperties": {}
      }
    }
  }
