{
  "name": "react-example",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/smartcheck/import/spreadsheet-worker.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/spreadsheet-worker.cjs",
    "verify": "pnpm run lint && pnpm test && pnpm run build",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:a11y": "tsx --test src/lib/a11y-audit.test.ts",
    "test:a11y:e2e": "tsx scripts/e2e-a11y-smoke.ts",
    "academy:parity": "node scripts/academy-parity-check.mjs",
    "allplan:inventory": "node scripts/allplan-source-inventory.mjs",
    "allplan:structural-audit": "tsx scripts/allplan-structural-audit.mjs",
    "allplan:review-validate": "tsx scripts/validate-allplan-content-review.mjs",
    "allplan:import": "node scripts/import-allplan-source.mjs",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:database-roles:pg": "tsx --test src/contracts/database-role-provision.pgtest.ts",
    "test:tenant-rls:pg": "tsx --test src/contracts/cde-tenant-rls.pgtest.ts",
    "database-roles:inspect": "tsx scripts/database-roles/cli.ts inspect",
    "database-roles:provision": "tsx scripts/database-roles/cli.ts provision",
    "smartcheck:evaluate": "tsx src/smartcheck/evaluation/cli-main.ts",
    "smartcheck:integration": "tsx --test src/smartcheck/import/integration-contract.test.ts",
    "smartcheck:http-integration": "tsx --test src/server/routes/smartcheck.integration.test.ts",
    "smartcheck:fixtures": "tsx --test src/smartcheck/import/pilot-fixtures.test.ts",
    "excel:corpus": "tsx scripts/inspect-contractor-excels.ts",
    "smartcheck:pilot-check": "tsx scripts/smartcheck-pilot-readiness.ts",
    "smartcheck:storage-smoke": "tsx scripts/smartcheck-storage-smoke.ts",
    "smartcheck:worker": "tsx src/smartcheck/import/worker.ts",
    "smartcheck:ifc-worker": "tsx src/smartcheck/import/ifc-worker.ts",
    "contracts:generate": "tsx scripts/generate-contract-schemas.ts",
    "prisma:validate:shadow": "DATABASE_URL=\"${DATABASE_URL:-postgresql://shadow:shadow@127.0.0.1:5432/teklifpro_next_local}\" prisma validate --schema=prisma/shadow/schema.prisma",
    "prisma:shadow-contract": "tsx scripts/validate-prisma-shadow-contract.ts",
    "prisma:shadow-db:plan": "tsx scripts/prisma-shadow-parity.ts --plan",
    "prisma:shadow-db:prepare": "tsx scripts/prisma-shadow-parity.ts --prepare",
    "prisma:shadow-parity": "tsx scripts/prisma-shadow-parity.ts",
    "postgres:restore-drill:plan": "tsx scripts/postgres-restore-drill.ts --plan",
    "postgres:restore-drill": "tsx scripts/postgres-restore-drill.ts --prepare",
    "postgres:restore-drill:verify": "tsx scripts/postgres-restore-drill.ts",
    "test:progress-payment-tenant-rls:pg": "tsx --test src/contracts/progress-payment-tenant-rls.pgtest.ts",
    "test:smartcheck-pilot-tenant-rls:pg": "tsx --test src/contracts/smartcheck-pilot-tenant-rls.pgtest.ts",
    "test:company-industry-tenant-rls:pg": "tsx --test src/contracts/company-industry-tenant-rls.pgtest.ts",
    "test:crm-lead-tenant-rls:pg": "tsx --test src/contracts/crm-lead-tenant-rls.pgtest.ts",
    "test:tenant-business-rls:pg": "tsx --test src/contracts/tenant-business-rls.pgtest.ts",
    "test:t44-recovery:pg": "tsx --test src/contracts/t44-recovery-drill.pgtest.ts",
    "test:coverage": "c8 tsx --test --test-concurrency=1 \"src/**/*.test.ts\" && tsx scripts/ci/coverage-gate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@google/generative-ai": "^0.23.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@sentry/node": "10.75.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "graphile-worker": "0.16.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "nodemailer": "10.1.0",
    "pg": "^8.20.0",
    "prisma": "^6.16.2",
    "puppeteer": "^25.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "23.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3",
    "web-ifc": "0.0.78",
    "yauzl": "^3.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.186.0",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "c8": "12.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
